# Copy to .env.local and adjust.

# Base URL of the Mindsy API (no trailing slash).
# Development:
NEXT_PUBLIC_API_URL=http://127.0.0.1:8010

# Leave it EMPTY to call the API through this same origin, which Next.js proxies
# via /api/* (see next.config.ts). Useful for single-host previews.
# NEXT_PUBLIC_API_URL=

# Only used by the proxy above. Server-side, not exposed to the browser.
API_PROXY_TARGET=http://127.0.0.1:8010
