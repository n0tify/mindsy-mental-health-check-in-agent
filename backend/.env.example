# Mindsy backend environment. Copy to .env and adjust.

# Only explicit local development permits the example JWT secret.
APP_ENV=development

# SQLite for development (file lives next to the app).
DATABASE_URL=sqlite:///./mindsy.db

# PostgreSQL for production (e.g. Neon):
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname?sslmode=require

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-value

# How long an access token stays valid.
ACCESS_TOKEN_DAYS=7

# Comma separated list of browser origins allowed to call the API.
# Production: set to your Vercel frontend HTTPS origin, e.g.
# CORS_ORIGINS=https://mindsy-frontend.vercel.app
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional Azure OpenAI Companion integration. Disabled by default.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_ENABLED=false
